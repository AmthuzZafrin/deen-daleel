# ---- Anthropic (offline answer drafting ONLY) ----
# Not used at runtime. /api/ask serves reviewed answers and makes no Anthropic
# call, so leave this unset unless you are running scripts/generateAnswers.ts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Embeddings + reranking ----
# Default is "local": BGE-M3 running on this machine. No key, no quota, no cost.
# Start the service with:  cd ingest && .venv/bin/python -m serve_embeddings
# Set to "voyage" to use the hosted API instead (then VOYAGE_API_KEY is needed).
#
# Switching backends needs no migration — both emit 1024 dimensions — but it
# DOES need the corpus re-embedded. Vectors from two models are not comparable.
EMBEDDING_BACKEND=local

# The web app reaches the local service through this. It speaks Voyage's wire
# format, so the same client code works against either.
VOYAGE_BASE_URL=http://127.0.0.1:8001/v1
VOYAGE_API_KEY=local

# Only needed when EMBEDDING_BACKEND=voyage.
# Get one at https://dash.voyageai.com/api-keys
# VOYAGE_API_KEY=pa-...

# Optional. Lower if the GPU runs out of memory during ingestion (default 8).
# LOCAL_BATCH_SIZE=8

# Optional. Minimum rerank score for a stored answer to be served (default 0.5).
# Tune from query_log; erring high is safer than serving a wrong answer.
# DEEN_MATCH_THRESHOLD=0.5

# ---- Database ----
# Matches scripts/db.sh defaults. Change POSTGRES_PASSWORD in real deployments.
DATABASE_URL=postgresql://deen:deen@localhost:5433/deen_daleel

# ---- App ----
# Used to sign the anonymous-session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Guards /review and /api/review — the only place unreviewed material becomes
# public guidance under a named reviewer. Generate with: openssl rand -hex 32
#
# Leave it unset and review works on localhost but is refused outright in
# production, so forgetting it takes the review page down rather than leaving it
# open. Set it before deploying anywhere reachable.
# REVIEW_TOKEN=
