# Copy to .env. Nothing here is a secret in the local setup: embeddings and
# reranking run on this machine, and the key is only there because the client
# speaks Voyage's wire format.

DATABASE_URL=postgresql://deen:deen@localhost:5433/deen_daleel

# The local BGE-M3 service (ingest/serve_embeddings.py, port 8001). It answers
# Voyage's API shape, so the client is unchanged; the key is a placeholder it
# never checks. Point this at https://api.voyageai.com/v1 with a real key to
# use Voyage instead — but note the corpus is embedded with BGE-M3, and vectors
# from two models are not comparable, so that needs a full re-embed.
VOYAGE_BASE_URL=http://127.0.0.1:8001/v1
VOYAGE_API_KEY=local

# Gates /review and /api/review, reads as well as writes. Fails closed in
# production and open on loopback, so leaving this unset is fine locally and
# fatal in deployment. Set it to a long random string before the app is
# reachable by anyone else.
REVIEW_TOKEN=

# Only the offline drafting script uses this. There is no model call in the
# request path and there is not meant to be one.
ANTHROPIC_API_KEY=
